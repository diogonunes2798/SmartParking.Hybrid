{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Persistence variant (Phase 8, ADR-0012): Hybrid (PostgreSQL + MongoDB + Redis) or Monolithic (PostgreSQL only,
  // for the comparison of Cap. 6.5). Override with the environment variable Persistence__Mode.
  "Persistence": {
    "Mode": "Hybrid",
    "Monolithic": {
      // How often the event writer checks whether the UC-05 columns exist (AddEnvironmentalColumns).
      "SchemaRefreshInterval": "00:00:05",
      "MaxWriteAttempts": 3
    }
  },
  // UC-04 report (Phase 6, ADR-0010): IANA time zone of the day, week and month periods.
  "Reports": {
    "TimeZone": "Europe/Lisbon"
  },
  "Observability": {
    // Latency targets of spec §6 (RNF-01), exported as smartparking_target_seconds (ADR-0009).
    // IngestionEndToEndP95 is decision D7 (default < 1 s p95). ConsistencyWindowP95 has no target in the
    // specification: TODO(Diogo).
    "Targets": {
      "IngestionEndToEndP95": "00:00:01",
      "AvailabilityQueryP95": "00:00:00.200",
      "SessionWriteP95": "00:00:02"
    }
  }
}
