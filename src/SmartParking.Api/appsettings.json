{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "Mode": "Hybrid"
  },
  "Reservations": {
    "MaxDurationHours": 24,
    "MaxAdvanceDays": 7,
    "EarlyArrivalMinutes": 15,
    "ExpiryGraceMinutes": 15,
    "ExpiryScanSeconds": 60
  },
  "Ingestion": {
    "FutureTolerance": "00:05:00",
    "RetryAfterSeconds": 1
  },
  "Availability": {
    "RetryAfterSeconds": 1
  },
  "Mongo": {
    "Database": "smartparking"
  },
  "HealthChecks": {
    "Timeout": "00:00:05"
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=smartparking;Username=smartparking_api",
    "Mongo": "mongodb://localhost:27017/?replicaSet=rs0",
    "Redis": "localhost:6379"
  }
}
