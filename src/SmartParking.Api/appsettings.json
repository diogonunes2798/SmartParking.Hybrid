{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "Mode": "Hybrid"
  },
  "HealthChecks": {
    "Timeout": "00:00:05"
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=smartparking;Username=smartparking_api",
    "Mongo": "mongodb://localhost:27017/?replicaSet=rs0",
    "Redis": "localhost:6379"
  }
}
