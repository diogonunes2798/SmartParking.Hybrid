{
  // Development-only credentials matching docker-compose.yml defaults.
  // Maximum Pool Size=40 per process (Phase 9a; review of Phase 2b, finding 1): the API and the Workers together
  // stay below PostgreSQL's max_connections (100), so a load test cannot fail with 53300.
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=smartparking;Username=smartparking;Password=smartparking;Maximum Pool Size=40",
    "Mongo": "mongodb://smartparking:smartparking@localhost:27017/?authSource=admin",
    "Redis": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // SQL sent by EF Core (Phase 6 manual test: the occupancy report must show only analytics.* tables).
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}
