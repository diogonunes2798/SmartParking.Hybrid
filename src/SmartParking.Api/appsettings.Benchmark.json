{
  // Environment used by bench/run.sh (Phase 9a): the same development-only credentials as appsettings.Development.json,
  // but without the per-statement SQL log of Development (it would add I/O to every request being measured) and
  // without Swagger. Maximum Pool Size=40 per process: the API and one Workers instance stay below PostgreSQL's
  // max_connections (100) (review of Phase 2b, finding 1).
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=smartparking;Username=smartparking;Password=smartparking;Maximum Pool Size=40",
    "Mongo": "mongodb://smartparking:smartparking@localhost:27017/?authSource=admin",
    "Redis": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
