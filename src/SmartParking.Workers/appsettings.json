{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  // Outbox relay (Phase 5, ADR-0009). Set Enabled to false to run a Workers instance without it.
  "Outbox": {
    "Enabled": true,
    "BatchSize": 100,
    "PollInterval": "00:00:00.100"
  },
  // Occupancy aggregation into analytics.occupancy_hourly (UC-04, Phase 6, ADR-0010). AllowedLateness is
  // provisional: TODO(Diogo).
  "Analytics": {
    "Enabled": true,
    "Interval": "00:01:00",
    "AllowedLateness": "00:02:00",
    "ReaggregateHours": 2,
    "MaxHoursPerRun": 24
  },
  "Observability": {
    // Latency targets of spec §6 (RNF-01), exported as smartparking_target_seconds (ADR-0009).
    // IngestionEndToEndP95 is decision D7 (default < 1 s p95). ConsistencyWindowP95 has no target in the
    // specification: TODO(Diogo).
    "Targets": {
      "IngestionEndToEndP95": "00:00:01",
      "AvailabilityQueryP95": "00:00:00.200",
      "SessionWriteP95": "00:00:02"
    }
  }
}
