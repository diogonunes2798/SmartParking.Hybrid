# Code generated by `dotnet ef migrations add` (spec 001). Treated as generated code, so analyzers
# (for example CA1861 on the column arrays) and `dotnet format` leave it as EF Core wrote it.
# Hand-written helpers in this folder (Sql/MigrationSql.cs) do not match and keep the full analysis.
[{2*_*.cs,*ModelSnapshot.cs}]
generated_code = true
